{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://homio/schemas/location.json",
  "title": "Location",
  "$defs": {
    "Room": {
      "type": "object",
      "required": ["id", "houseId", "name"],
      "properties": {
        "id": { "type": "string" },
        "houseId": { "type": "string" },
        "name": { "type": "string" },
        "floor": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
