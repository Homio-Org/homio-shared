{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://homio/schemas/location.json",
  "title": "HouseAndRoom",
  "description": "Shared models for house and room entities",
  "$defs": {
    "Room": {
      "type": "object",
      "required": ["id", "houseId", "name"],
      "properties": {
        "id": { "type": "string" },
        "houseId": { "type": "string" },
        "name": { "type": "string" },
        "floor": { "type": "string" }
      },
      "additionalProperties": false
    },
    "House": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "timezone": { "type": "string" },
        "rooms": {
          "type": "array",
          "items": { "$ref": "#/$defs/Room" }
        }
      },
      "additionalProperties": false
    }
  },
  "oneOf": [{ "$ref": "#/$defs/House" }, { "$ref": "#/$defs/Room" }]
}
