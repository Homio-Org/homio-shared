{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://homio/schemas/mqtt-payloads.json",
  "title": "MqttPayloads",
  "description": "Common MQTT payload schemas for Homio topics",
  "$defs": {
    "DeviceCommandPayload": {
      "type": "object",
      "description": "Command payload published to smart-home/{houseId}/device/{deviceId}/command",
      "properties": {
        "action": { "type": "string" },
        "params": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": true
    },
    "DeviceStatePayload": {
      "allOf": [
        { "$ref": "device-state.json" },
        {
          "type": "object",
          "properties": {
            "event": { "type": "string", "const": "state_updated" },
            "timestamp": { "type": "string", "format": "date-time" }
          }
        }
      ]
    },
    "TelemetryPayload": {
      "allOf": [
        { "$ref": "telemetry.json" },
        {
          "type": "object",
          "properties": {
            "event": { "type": "string", "const": "telemetry" },
            "timestamp": { "type": "string", "format": "date-time" }
          },
          "additionalProperties": true
        }
      ]
    },
    "TelemetryReceivedEventPayload": {
      "type": "object",
      "required": ["event", "houseId", "deviceId", "timestamp", "payload"],
      "properties": {
        "event": { "type": "string", "const": "telemetry.received" },
        "houseId": { "type": "string" },
        "deviceId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "payload": { "$ref": "#/$defs/TelemetryPayload" }
      },
      "additionalProperties": false
    },
    "DeviceStateUpdatedEventPayload": {
      "type": "object",
      "required": ["event", "houseId", "deviceId", "timestamp", "payload"],
      "properties": {
        "event": { "type": "string", "const": "device.state.updated" },
        "houseId": { "type": "string" },
        "deviceId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "payload": { "$ref": "#/$defs/DeviceStatePayload" }
      },
      "additionalProperties": false
    },
    "RuleTriggeredEventPayload": {
      "type": "object",
      "required": ["event", "houseId", "ruleId", "timestamp", "payload"],
      "properties": {
        "event": { "type": "string", "const": "rule.triggered" },
        "houseId": { "type": "string" },
        "ruleId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "payload": { "$ref": "rule.json" }
      },
      "additionalProperties": false
    },
    "NotificationRequestedEventPayload": {
      "type": "object",
      "required": ["event", "houseId", "timestamp", "payload"],
      "properties": {
        "event": { "type": "string", "const": "notification.requested" },
        "houseId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "payload": { "$ref": "notification.json" }
      },
      "additionalProperties": false
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/DeviceCommandPayload" },
    { "$ref": "#/$defs/DeviceStatePayload" },
    { "$ref": "#/$defs/TelemetryPayload" },
    { "$ref": "#/$defs/TelemetryReceivedEventPayload" },
    { "$ref": "#/$defs/DeviceStateUpdatedEventPayload" },
    { "$ref": "#/$defs/RuleTriggeredEventPayload" },
    { "$ref": "#/$defs/NotificationRequestedEventPayload" }
  ]
}
