{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://homio/schemas/telemetry.json",
  "title": "Telemetry",
  "description": "Device telemetry payload published to MQTT",
  "type": "object",
  "properties": {
    "temperature": {
      "type": "number",
      "description": "Temperature in Celsius"
    },
    "humidity": {
      "type": "number",
      "description": "Relative humidity in percent (0–100)"
    },
    "sound_level": {
      "type": "number",
      "description": "Sound level (e.g. dB)"
    },
    "illuminance": {
      "type": "number",
      "description": "Illuminance in lux"
    },
    "co2": {
      "type": "number",
      "description": "CO2 concentration in ppm"
    },
    "motion": {
      "type": "boolean",
      "description": "Motion detected"
    },
    "ts": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of the reading"
    },
    "battery": {
      "type": "number",
      "description": "Battery level (e.g. 0–100 percent or voltage)"
    }
  },
  "additionalProperties": true
}
